# Normalize text files to LF
* text=auto

# Source code
*.c       text eol=lf
*.cc      text eol=lf
*.cpp     text eol=lf
*.h       text eol=lf
*.hpp     text eol=lf
*.cmake   text eol=lf

# Configuration and documentation
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.ini     text eol=lf
*.conf    text eol=lf
*.sql     text eol=lf
*.sh      text eol=lf
*.xml     text eol=lf

# Python
*.py       text eol=lf
*.pyi      text eol=lf
*.toml     text eol=lf
*.lock     text eol=lf

# Python bytecode
*.pyc      binary
*.pyo      binary

.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf

# Windows scripts
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.psm1    text eol=crlf

# Binary files
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.zip     binary
*.7z      binary
*.exe     binary
*.dll     binary
*.pdb     binary
*.lib     binary
*.mpq     binary
