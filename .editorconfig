root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,md}]
indent_size = 2

[*.{bat,cmd,ps1,psm1}]
end_of_line = crlf

[*.{bat,cmd}]
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_style = space
indent_size = 4

[*.toml]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.patch]
trim_trailing_whitespace = false
