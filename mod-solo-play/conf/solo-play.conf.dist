[worldserver]
# Disabled until operator runtime acceptance. See README.md for formulas and tuning.
# Profiles: Balanced, Solo, Duo (case sensitive). Only 1-2 participants supported.
# Overrides: "id:health:damage;id:health:damage"; exclusions: comma-separated IDs.
# Multipliers are finite and bounded; invalid options log and use defaults.
# Successful reload is deferred until combat ends and the settle window expires.

SoloPlay.Enable = 0
SoloPlay.Profile = Balanced
SoloPlay.Legacy.Enable = 1
SoloPlay.Heroic.Enable = 1
SoloPlay.Dungeons.Enable = 1
SoloPlay.Raids.Enable = 1
